# Copy this file to .env.local and fill values locally.
# Do not commit .env.local or paste these keys into chat.

LITELLM_API_KEY=replace-with-local-proxy-key
OPENAI_API_KEY=replace-with-your-openai-relay-key
OPENAI_API_BASE=https://your-openai-relay.example.com/v1
DEEPSEEK_API_KEY=replace-with-your-deepseek-key

# Optional browser web access for Research Pack. No API key required.
# Set TEAM_AGENT_BROWSER_PROVIDER=chrome to let scripts/start-litellm-harness.ps1
# launch the bundled local Chrome CDP proxy automatically.
TEAM_AGENT_ALLOW_BROWSER_ACCESS=0
TEAM_AGENT_BROWSER_PROVIDER=mock
TEAM_AGENT_BROWSER_SEARCH_ENGINE=bing
TEAM_AGENT_BROWSER_CDP_URL=http://127.0.0.1:3456
# Chrome mode uses 9223 internally for the Chrome DevTools endpoint by default.
# Optional when Chrome is not in a standard Windows install path.
TEAM_AGENT_CHROME_PATH=
TEAM_AGENT_CHROME_PROFILE_DIR=output/chrome-cdp-profile
